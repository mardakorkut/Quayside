# ==================== REQUIRED ====================
ENV=development
SECRET_KEY=replace-with-strong-secret

# AIS Data Source
AISSTREAM_API_KEY=replace-with-aisstream-key

# Database
DATABASE_URL=postgresql://user:password@localhost:5432/vessel_tracker

# Redis Cache
REDIS_URL=redis://:password@localhost:6379/0

# ==================== OPTIONAL ====================
HOST=0.0.0.0
PORT=5000
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000,http://localhost:5000
